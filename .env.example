
# ── PostgreSQL ────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# ── Backend ───────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/postgres

# JWT — сгенерируйте: openssl rand -hex 32
SECRET_KEY=replace-me-with-a-random-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Включить SQL-логи (true только в dev)
DEBUG=false

# ── CORS ──────────────────────────────────────
# Разрешённые источники через запятую
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── SMTP (email) ──────────────────────────────
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@tutorspace.local
MAIL_FROM_NAME=TutorSpace
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# VAPID — Web Push (сгенерируйте своими ключами)
VAPID_PRIVATE_KEY=your-vapid-private-key-pem
VAPID_PUBLIC_KEY=your-vapid-public-key-urlsafe-base64
VAPID_CLAIMS_EMAIL=admin@yourdomain.com

# URL фронтенда (для ссылок в письмах)
FRONTEND_URL=http://localhost

# ── Подписки (кошелёк платформы для приёма оплаты от репетиторов) ─────────────
PLATFORM_YOOMONEY_WALLET=

# ── Frontend (только для локальной разработки вне Docker) ──────────────────
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
